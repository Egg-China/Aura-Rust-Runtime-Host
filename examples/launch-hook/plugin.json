{
  "schemaVersion": 5,
  "id": "dev.hmclce.example.rust.launch-hook",
  "name": "Aura Rust Game Launch Hook Plugin",
  "version": "1.0.0",
  "description": "Aura Rust example that observes the before-game-launch Hook and FileUtils.getName after Patch.",
  "author": "Aura Launcher Community",
  "type": "java",
  "runtime": "rust",
  "abi": 1,
  "platforms": [
    "windows-x64"
  ],
  "entrypoint": "payload/hmcl_rust_launch_hook.dll",
  "executionMode": "isolated",
  "runtimeProvider": "dev.hmclce.runtime.rust-host",
  "dependencies": [],
  "permissions": [
    "launcher-hook",
    "launcher-patch"
  ],
  "requiredPermissions": [
    "launcher-hook",
    "launcher-patch"
  ],
  "hooks": [
    "before-game-launch"
  ],
  "patches": [
    {
      "target": "org.jackhuang.hmcl.util.io.FileUtils",
      "method": "getName",
      "type": "after",
      "parameters": [
        "java.nio.file.Path"
      ]
    }
  ],
  "launcherVersion": ">=27.1-0-next"
}
